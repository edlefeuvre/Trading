#!/usr/bin/env python3
r"""bin/trade-report — one record per setup the engine produced, plus the paper-track register.

The charter's 20-trade validation runs on TWO tracks that are never merged:

  paper track   every setup the engine produced, whether or not Ed acted on it.
                Complete and unbiased by who was awake. Tests the STRATEGY.
  traded track  only setups Ed actually put on the exchange. Tests EXECUTION.

The difference between the two is the cost of being a human in the loop.

Status vocabulary (in results/trade-status.yaml, keyed "<SYMBOL>@<fvg_bar_ms>"):
  Traded    an order went on the exchange
  Partial   part of the ticket was placed, or it filled partly
  Skipped   a deliberate decision under a rule (e.g. pool consumed) not to place it
  Untraded  no decision taken — nobody was at the desk
  Expired   the strategy's own order never filled inside the window (not Ed's choice)

Untraded / Skipped / Expired get a short auto record; Traded / Partial get a stub
marked TODO, because those need the human half — state of mind, execution notes,
post-mortem — which no script can write.

    python bin/trade-report --bars 400                  # write records + register
    python bin/trade-report --bars 400 --dry-run        # list, write nothing
    python bin/trade-report --out "%USERPROFILE%\OneDrive\TRA\30_Reports"

Nothing here reads runner state, sends Telegram, or touches an exchange key.
"""
from __future__ import annotations

import argparse
import csv
import datetime as dt
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from common.data import binance_klines as data          # noqa: E402
from common.engine import ict_base as engine            # noqa: E402

TZ_LOCAL_OFFSET_H = 2          # Gibraltar, UTC+2 — filenames use local date/time
AUTO = {"Untraded", "Skipped", "Expired"}


def load_yaml(p: Path):
    import yaml
    with open(p, encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def local(ms: int) -> dt.datetime:
    return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc) + dt.timedelta(hours=TZ_LOCAL_OFFSET_H)


def utc(ms: int) -> str:
    return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc).strftime("%a %d %b %Y %H:%M UTC")


def stem(ts_id: str, sym: str, side: str, mode: str, status: str) -> str:
    return f"{ts_id}-{sym}-{side}-{mode}-{status}"


def chart_url(sym: str, tf: str) -> str:
    iv = tf.replace("m", "")
    return f"https://www.tradingview.com/chart/?symbol=BINANCE:{sym}.P&interval={iv}"


def record(e: dict, sym: str, ts_id: str, tf: str, status: str, mode: str, name: str) -> str:
    side = "SELL" if e["d"] == -1 else "BUY"
    word = "short" if e["d"] == -1 else "long"
    L = [f"# {sym} · {side} ({word}) · {ts_id} CHoCH ICT {tf} (v1.0) · {mode} · {status}", ""]
    if status in AUTO:
        L += ["_Auto-generated by `bin/trade-report` from the engine. No human notes: nothing was traded._", ""]
    else:
        L += ["**TODO — this one was traded.** Add state of mind at entry and close, the exchange fills",
              "and order ids (`python -m common.exchange.binance --history " + sym + " --hours 48`),",
              "an A/B/C grade and a post-mortem. The levels below are the engine's.", ""]
    L += [f"- **Setup bar (FVG):** {utc(e['t_placed'])} ({local(e['t_placed']):%H:%M} local)",
          f"- **Entry:** {e['mid']:g} — FVG midpoint (limit, maker, post-only)",
          f"- **Stop:** {e['stop']:g} ({e['stop_pct']:.2f}%) — the sweep extreme",
          f"- **Target:** {e['target']:g} — pivot A · **pool {e['poolR']:.2f} R**"]
    if e["status"] == "closed":
        L.append(f"- **Paper outcome:** {e['outcome']} **{e['net_R']:+.2f} R** · exit {utc(e['t_exit'])}")
    elif e["status"] == "open":
        L.append(f"- **Paper outcome:** open, unrealised {e['unreal_R']:+.2f} R · filled {utc(e['t_filled'])}")
    else:
        L.append(f"- **Paper outcome:** never filled inside the {e.get('bars_left', 0)}-bar window — expired")
    L += [f"- **Status:** {status}",
          "- **Pine cross-check:** ⟨agreed / not shown / not checked⟩ — does the TradingView script flag this bar?",
          f"- **Chart:** {chart_url(sym, tf)}",
          "",
          f"Counts toward the **paper track**{' and the **traded track**' if status not in AUTO else ' only'}.",
          f"File: `{name}`", ""]
    return "\n".join(L)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--strategy", default="TS01_CHoCH_ICT_15m_Binance_USDCp")
    ap.add_argument("--bars", type=int, default=400)
    ap.add_argument("--symbols", default="")
    ap.add_argument("--out", default="", help="directory for the records (default results/trade-reports)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="rewrite records that already exist")
    a = ap.parse_args(argv)

    here = REPO / "strategies" / a.strategy
    ts_id = a.strategy.split("_")[0]
    params = load_yaml(here / "config" / "params.yaml")
    universe = load_yaml(here / "config" / "universe.yaml")
    entry, structure, dcfg = params.get("entry", {}), params.get("structure", {}), params.get("data", {})
    k = int(structure.get("pivot_k", engine.K))
    live_bars = int(entry.get("gtc_window_bars", engine.LIVE_BARS))
    sweep_reclaim = int(entry.get("sweep_reclaim_bars", engine.SWEEP_RECLAIM))
    fvg_window = int(entry.get("gap_window_bars", engine.FVG_WINDOW))
    discount_only = bool(entry.get("discount_only", True))
    tf = str(params.get("timeframe", "15m"))
    mode = "Auto" if str(params.get("mode", "PAPER")).upper() == "LIVE" else "Paper"
    need = max(int(dcfg.get("history_bars", 1500)), a.bars + 200)

    status_file = here / "results" / "trade-status.yaml"
    overrides = load_yaml(status_file) if status_file.is_file() else {}

    syms = ([s.strip().upper() for s in a.symbols.split(",")] if a.symbols else
            [str(r["symbol"]).upper() for r in universe.get("symbols", [])
             if isinstance(r, dict) and float(r.get("tier", 0) or 0) > 0])

    outdir = Path(a.out) if a.out else here / "results" / "trade-reports"
    rows, written = [], 0
    for sym in syms:
        try:
            bars = data.klines_paged(sym, need, interval=tf)
        except Exception as ex:  # noqa: BLE001
            print(f"{sym:<14} ERROR {ex}")
            continue
        n = len(bars)
        for e in engine.live_state(bars, k=k, live_bars=live_bars, report_all=True,
                                   sweep_reclaim=sweep_reclaim, fvg_window=fvg_window,
                                   discount_only=discount_only):
            if (n - 1) - e["fvg_bar"] > a.bars:
                continue
            key = f"{sym}@{e['t_placed']}"
            ov = overrides.get(key) or {}
            status = str(ov.get("status") or ("Expired" if e["status"] == "expired" else "Untraded"))
            side = "SELL" if e["d"] == -1 else "BUY"
            lt = local(e["t_placed"])
            name = stem(f"{lt:%Y%m%d-%H%M}-{ts_id}", sym, side, mode, status) + ".md"
            rows.append(dict(file=name, key=key, setup_utc=utc(e["t_placed"]), symbol=sym, side=side,
                             entry=e["mid"], stop=e["stop"], target=e["target"],
                             pool_R=round(e["poolR"], 2), engine_status=e["status"],
                             paper_R=round(e.get("net_R", 0.0), 2) if e["status"] == "closed" else "",
                             outcome=e.get("outcome", e["status"]), status=status,
                             pine=ov.get("pine", ""), chart=ov.get("chart", chart_url(sym, tf))))
            path = outdir / name
            if a.dry_run:
                print(("would write " if not path.exists() else "exists      ") + name)
                continue
            if path.exists() and not a.force:
                continue
            outdir.mkdir(parents=True, exist_ok=True)
            path.write_text(record(e, sym, ts_id, tf, status, mode, name), encoding="utf-8")
            written += 1

    rows.sort(key=lambda r: r["file"])
    paper = [r for r in rows if r["paper_R"] != ""]
    traded = [r for r in paper if r["status"] in ("Traded", "Partial")]
    tot = lambda rs: sum(float(r["paper_R"]) for r in rs)  # noqa: E731
    print(f"\npaper track : {len(paper)} filled setup(s), {tot(paper):+.2f} R"
          f" ({len([r for r in paper if float(r['paper_R']) > 0])} win)")
    print(f"traded track: {len(traded)} setup(s), {tot(traded):+.2f} R on the paper record"
          " (replace with exchange figures)")
    if not a.dry_run:
        reg = outdir / f"{ts_id}-paper-track.csv"
        outdir.mkdir(parents=True, exist_ok=True)
        with open(reg, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.DictWriter(f, fieldnames=list(rows[0].keys()) if rows else ["file"])
            w.writeheader()
            w.writerows(rows)
        print(f"\n{written} record(s) written, register {reg}")
        print(f"Set who traded what in {status_file} (key: SYMBOL@fvg_bar_ms), then re-run with --force.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
