#!/usr/bin/env python3
r"""bin/study-hours — does TS01's expectancy differ when Ed is asleep?

PRE-REGISTERED before the numbers were seen (3 Sep 2026, look #9):

  Question    Does mean net R per filled setup differ between setups whose FVG bar falls
              inside Ed's sleep window and those outside it?
  Comparison  ONE split: unattended (23:00-07:00 Europe/Gibraltar, DST-correct) vs attended.
              The hourly table this prints is DESCRIPTIVE ONLY and is not the test.
  Mechanism   TS01 needs the liquidity pool to be real. Overnight in Gibraltar is the Asia
              session with thin US participation, so a sweep is more likely to be noise and
              the draw weaker. That is why this is a hypothesis and not calendar mining.
  Expectation Unattended is WORSE. Declared before running.
  Decision    A time R factor, applied on top of the per-symbol factor, never above 1.0:
                1.0  mean R positive and not reliably worse than the attended bucket
                0.5  negative but the interval spans zero, OR positive but reliably worse
                0.0  negative with the interval excluding zero
              "Reliably" = the difference exceeds 2 standard errors. The rule is applied by
              this script, not by eye after the fact.
  Caveat      Report composition too. If the unattended bucket has systematically smaller
              pool R or wider stops, the driver is setup character, not the hour.

  Clocks       The sleep split is keyed on LOCAL time, because the question is about Ed's
               clock. Every hour-of-day and day-of-week view is keyed on UTC, because those
               questions are about the market's clock — local hours smear across DST (08:00
               Gibraltar is 06:00 UTC in summer and 07:00 UTC in winter).
  Heatmap      The day x hour grid is 168 cells. On ~1,200 trades that is ~7 per cell, which
               is noise: cells under --min-n are drawn hollow and excluded from any reading.
               It is there to show structure or its absence, never to nominate a cell.

    python bin/study-hours                       # tier>0 symbols, archive from 2024-01
    python bin/study-hours --html study.html     # also write the standalone report
    python bin/study-hours --all --start 2024-01
    python bin/study-hours --events results/event-days.txt    # secondary bucket, one date per line

First run downloads the monthly archive from data.binance.vision and caches it under
%USERPROFILE%\.config\trading-data — expect several minutes. No keys, no orders, no Telegram.
"""
from __future__ import annotations

import argparse
import datetime as dt
import statistics as stats
import sys
from pathlib import Path
REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from common.data import binance_klines as data          # noqa: E402
from common.engine import ict_base as engine            # noqa: E402

SLEEP_FROM, SLEEP_TO = 23, 7        # local hours; [23:00, 07:00)

# Gibraltar local time. Windows ships no tz database, so zoneinfo needs the `tzdata`
# package; if it is absent we apply the EU rule directly — DST from the last Sunday in
# March 01:00 UTC to the last Sunday in October 01:00 UTC, CEST (UTC+2) inside, CET
# (UTC+1) outside. That rule has been fixed since 1996, so it is exact for this dataset.
_TZ = None
try:
    from zoneinfo import ZoneInfo
    _TZ = ZoneInfo("Europe/Gibraltar")
    TZ_NOTE = "Europe/Gibraltar via zoneinfo"
except Exception:  # noqa: BLE001 — no tzdata on this machine
    TZ_NOTE = "Europe/Gibraltar via the built-in EU rule (tzdata not installed)"


def _last_sunday(year: int, month: int) -> dt.date:
    d = dt.date(year, month, 31) if month != 2 else dt.date(year, 2, 28)
    while d.month != month:
        d -= dt.timedelta(days=1)
    return d - dt.timedelta(days=(d.weekday() + 1) % 7)


def local_dt(ms: int) -> dt.datetime:
    """The wall-clock time in Gibraltar for a UTC millisecond timestamp."""
    u = dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc)
    if _TZ is not None:
        return u.astimezone(_TZ)
    start = dt.datetime.combine(_last_sunday(u.year, 3), dt.time(1), dt.timezone.utc)
    end = dt.datetime.combine(_last_sunday(u.year, 10), dt.time(1), dt.timezone.utc)
    return u + dt.timedelta(hours=2 if start <= u < end else 1)


def load_yaml(p: Path):
    import yaml
    with open(p, encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def unattended(ms: int) -> bool:
    h = local_dt(ms).hour
    return h >= SLEEP_FROM or h < SLEEP_TO


def summary(rows: list[dict]) -> dict:
    R = [r["net_R"] for r in rows]
    n = len(R)
    if n == 0:
        return dict(n=0)
    sd = stats.stdev(R) if n > 1 else 0.0
    return dict(n=n, mean=stats.fmean(R), total=sum(R), sd=sd, se=(sd / n ** 0.5) if n else 0.0,
                win=sum(1 for x in R if x > 0) / n,
                pool=stats.fmean([r["poolR"] for r in rows]),
                stop=stats.fmean([r["stop_pct"] for r in rows]))


def line(label: str, s: dict, setups: int) -> str:
    if not s.get("n"):
        return f"  {label:<12} no filled trades"
    return (f"  {label:<12} setups {setups:>5}  filled {s['n']:>5} ({100*s['n']/setups:>4.0f}%)  "
            f"mean {s['mean']:+.3f} R  ± {s['se']:.3f} (1 se)  total {s['total']:+8.1f} R  "
            f"win {100*s['win']:>4.1f}%  pool {s['pool']:.2f} R  stop {s['stop']:.2f}%")


def verdict(a: dict, b: dict) -> tuple[float, str]:
    """The pre-registered rule. a = unattended, b = attended. Returns (factor, why)."""
    if not a.get("n"):
        return 0.5, "no unattended trades in the sample — hold at 0.5 until there are"
    lo, hi = a["mean"] - 2 * a["se"], a["mean"] + 2 * a["se"]
    if hi < 0:
        return 0.0, f"mean {a['mean']:+.3f} R, 2-se interval [{lo:+.3f}, {hi:+.3f}] entirely below zero"
    if a["mean"] < 0:
        return 0.5, f"mean {a['mean']:+.3f} R negative but the interval [{lo:+.3f}, {hi:+.3f}] spans zero"
    if b.get("n"):
        diff = b["mean"] - a["mean"]
        se = (a["se"] ** 2 + b["se"] ** 2) ** 0.5
        if diff > 2 * se:
            return 0.5, f"positive, but {diff:.3f} R worse than attended vs 2 se = {2*se:.3f} R — reliably worse"
        return 1.0, f"positive at {a['mean']:+.3f} R and not reliably worse than attended ({diff:+.3f} R, 2 se {2*se:.3f})"
    return 1.0, f"positive at {a['mean']:+.3f} R"


# 3-hour blocks line up with the sessions, which is why they are the default: the bucket
# means something before the data is looked at, rather than being a convenient width.
SESSIONS = {(0, 3): "Asia late", (3, 6): "Asia into Europe", (6, 9): "Europe open",
            (9, 12): "Europe mid", (12, 15): "US pre-open", (15, 18): "US open",
            (18, 21): "US afternoon", (21, 24): "Asia open"}


def bucket_label(b: int, w: int) -> str:
    lo, hi = b * w, (b + 1) * w
    return f"{lo:02d}\u2013{hi:02d}"


def bucket_note(b: int, w: int) -> str:
    lo, hi = b * w, (b + 1) * w
    return SESSIONS.get((lo, hi), "")


# ---- standalone HTML report -------------------------------------------------
# Diverging ramp: blue (positive) <-> red (negative), neutral midpoint. Both arms are
# lightness-matched pair for pair and monotonic (light steps L .905/.812/.671/.575, dark
# steps L .34/.44/.55/.66), computed in OKLCH rather than picked by eye. Cell fills are
# low-contrast by design, so every cell also carries its number in ink — colour is never
# the only channel.
RAMP_LIGHT = dict(neg=["#f8d7d3", "#edb0aa", "#d8746e", "#c14e4a"],
                  pos=["#cde2fb", "#9ec5f4", "#5598e7", "#2a78d6"], zero="#f0efec")
RAMP_DARK = dict(neg=["#6f000c", "#971a20", "#bd413f", "#e3645f"],
                 pos=["#003578", "#0050a4", "#1a71cb", "#4294f1"], zero="#383835")
BANDS = (0.10, 0.25, 0.50)          # |mean R| cut points between the four steps


def _step(v: float) -> str:
    if v == 0:
        return "var(--d-0)"
    i = sum(1 for b in BANDS if abs(v) > b)
    return f"var(--d-{'p' if v > 0 else 'n'}{i + 1})"


def _mns(t: str) -> str:
    return t.replace("-", "−")


def _nice(v: float) -> float:
    """Round a limit outward to a friendly step so bars never clip."""
    if v <= 0:
        return 0.0
    for step in (0.1, 0.2, 0.25, 0.5, 1.0, 2.0, 5.0):
        if v <= step * 5:
            import math as _m
            return _m.ceil(v / step) * step
    return v


def _bars(series, lo, hi, xlab, wide=940, high=250):
    """Diverging bars: series is [(label, n, mean)]. lo/hi are floors — the scale grows to fit."""
    vals = [m for _, _, m in series] or [0.0]
    hi = max(hi, _nice(max(vals) * 1.18))
    lo = min(lo, -_nice(abs(min(vals)) * 1.28))
    PL, PR, PT, PB = 52, 14, 20, 48
    iw, ih = wide - PL - PR, high - PT - PB
    y0 = PT + ih * (hi / (hi - lo))
    sc = lambda v: ih * (v / (hi - lo))                                  # noqa: E731
    bw = iw / len(series)
    out = []
    nsteps = [lo, lo / 2, 0, hi / 3, 2 * hi / 3, hi]
    for v in nsteps:
        y = y0 - sc(v)
        out.append(f'<line x1="{PL}" x2="{wide-PR}" y1="{y:.1f}" y2="{y:.1f}" '
                   f'stroke="{"var(--axis)" if abs(v) < 1e-9 else "var(--grid)"}" stroke-width="{2 if abs(v)<1e-9 else 1}"/>')
        out.append(f'<text x="{PL-8}" y="{y+4:.1f}" class="ax end">{_mns(f"{v:+.1f}")}</text>')
    for i, (lab, n, mean) in enumerate(series):
        x = PL + i * bw
        bh = max(abs(sc(mean)), 1)
        by = y0 - sc(mean) if mean > 0 else y0
        col = "var(--pos)" if mean > 0 else "var(--neg)"
        out.append(f'<g><title>{lab} — n {n}, mean {mean:+.3f} R</title>'
                   f'<rect x="{x+2:.1f}" y="{by:.1f}" width="{bw-4:.1f}" height="{bh:.1f}" '
                   f'rx="{min(4, bw/2-1, bh):.1f}" fill="{col}"/></g>')
        out.append(f'<text x="{x+bw/2:.1f}" y="{high-PB+16}" class="ax mid">{lab}</text>')
        out.append(f'<text x="{x+bw/2:.1f}" y="{high-PB+29}" class="ax mid dim">{n}</text>')
        if abs(mean) > 0.20:
            ty = by - 6 if mean > 0 else min(by + bh + 13, PT + ih - 2)
            out.append(f'<text x="{x+bw/2:.1f}" y="{ty:.1f}" class="val mid">{_mns(format(mean, "+.2f"))}</text>')
    out.append(f'<text x="{PL}" y="{high-4}" class="ax">{xlab}</text>')
    return f'<svg viewBox="0 0 {wide} {high}" role="img" aria-label="{xlab}">' + "".join(out) + "</svg>"


def _heatmap(grid, DOW, min_n, NB, w, notes):
    CW = max(36, min(112, int(800 / NB)))
    PL, PT, CH = 46, 46, 40
    W, H = PL + NB * CW + 10, PT + 7 * CH + 46
    out = []
    for b in range(NB):
        out.append(f'<text x="{PL+b*CW+CW/2:.1f}" y="{PT-22}" class="ax mid">{bucket_label(b, w)}Z</text>')
        if notes and CW >= 84:
            out.append(f'<text x="{PL+b*CW+CW/2:.1f}" y="{PT-9}" class="ax mid dim">{bucket_note(b, w)}</text>')
    for d in range(7):
        y = PT + d * CH
        out.append(f'<text x="{PL-10}" y="{y+CH/2+4:.1f}" class="ax end">{DOW[d]}</text>')
        for b in range(NB):
            rows = grid[(d, b)]
            n = len(rows)
            x = PL + b * CW
            lb = bucket_label(b, w)
            if n < min_n:
                out.append(f'<g><title>{DOW[d]} {lb}Z — n {n}, below the n={min_n} floor, not read</title>'
                           f'<rect x="{x+1}" y="{y+1}" width="{CW-2}" height="{CH-2}" rx="4" fill="none" '
                           f'stroke="var(--line)" stroke-width="1"/>'
                           f'<text x="{x+CW/2:.1f}" y="{y+CH/2+4:.1f}" class="cell dim mid">{n}</text></g>')
                continue
            m = sum(r["net_R"] for r in rows) / n
            out.append(f'<g><title>{DOW[d]} {lb}Z — n {n}, mean {m:+.3f} R</title>'
                       f'<rect x="{x+1}" y="{y+1}" width="{CW-2}" height="{CH-2}" rx="4" fill="{_step(m)}"/>'
                       f'<text x="{x+CW/2:.1f}" y="{y+CH/2+1:.1f}" class="cell mid">{_mns(format(m, "+.2f"))}</text>'
                       f'<text x="{x+CW/2:.1f}" y="{y+CH/2+12:.1f}" class="cell dim mid">{n}</text></g>')
    out.append(f'<text x="{PL}" y="{H-22}" class="ax">{w}-hour blocks of the FVG bar, UTC · rows are UTC '
               f'weekday · hollow cells are below n={min_n} and are not read</text>')
    return f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="Mean net R by UTC weekday and hour">' + "".join(out) + "</svg>"


def write_html(a, un, at, setups, filled, by_uhour, by_ubucket, by_dow, grid, DOW, NB):
    from pathlib import Path as _P
    import datetime as _dt

    allrows = filled["unattended"] + filled["attended"]
    N = len(allrows)
    tot = sum(r["net_R"] for r in allrows)
    diff = at["mean"] - un["mean"]
    se = (un["se"] ** 2 + at["se"] ** 2) ** 0.5
    f, why = verdict(un, at)

    W = a.bucket_hours
    uh = [(f"{h:02d}", len(by_uhour[h]), (summary(by_uhour[h])["mean"] if by_uhour[h] else 0.0)) for h in range(24)]
    ub = [(bucket_label(b, W), len(by_ubucket[b]), (summary(by_ubucket[b])["mean"] if by_ubucket[b] else 0.0))
          for b in range(NB)]
    dw = [(DOW[d], len(by_dow[d]), (summary(by_dow[d])["mean"] if by_dow[d] else 0.0)) for d in range(7)]
    best = max((v for v in uh if v[1]), key=lambda v: v[2], default=("--", 0, 0.0))
    bn, bm = best[1], best[2]
    rest_n, rest_t = N - bn, tot - bm * bn
    ncell = [len(grid[k]) for k in grid]
    live = sum(1 for x in ncell if x >= a.min_n)

    def rowsfor(pairs):
        return "".join(f'<tr><td>{l}</td><td class="n">{n}</td><td class="n">{_mns(f"{m:+.3f}")}</td>'
                       f'<td class="n">{_mns(f"{m*n:+.1f}")}</td></tr>' for l, n, m in pairs)

    grid_rows = ""
    for d in range(7):
        cells = ""
        for h in range(NB):
            r = grid[(d, h)]
            if len(r) >= a.min_n:
                mv = sum(x["net_R"] for x in r) / len(r)
                cells += f'<td class="n">{_mns(format(mv, "+.2f"))} <span class="dimtxt">{len(r)}</span></td>'
            else:
                cells += f'<td class="n dimtxt">{len(r)}</td>'
        grid_rows += f"<tr><td>{DOW[d]}</td>{cells}</tr>"

    css = """
:root{color-scheme:light;--page:#f4f4f2;--surface:#fcfcfb;--surface-2:#f7f7f4;--ink:#0b0b0b;
 --ink-2:#52514e;--ink-3:#7c7b76;--line:#e3e2dd;--grid:#e9e8e3;--axis:#b6b5ae;--band:#efeee9;
 --pos:#2a78d6;--neg:#e34948;--flag:#fab219;--d-0:#f0efec;
 --d-n1:#f8d7d3;--d-n2:#edb0aa;--d-n3:#d8746e;--d-n4:#c14e4a;
 --d-p1:#cde2fb;--d-p2:#9ec5f4;--d-p3:#5598e7;--d-p4:#2a78d6;
 --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;--sans:system-ui,-apple-system,"Segoe UI",sans-serif;
 --serif:Georgia,"Times New Roman",serif;}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--page:#121211;--surface:#1a1a19;
 --surface-2:#201f1e;--ink:#fff;--ink-2:#c3c2b7;--ink-3:#8d8c84;--line:#2e2e2b;--grid:#272724;
 --axis:#4e4e4a;--band:#232320;--pos:#3987e5;--neg:#e66767;--d-0:#383835;
 --d-n1:#6f000c;--d-n2:#971a20;--d-n3:#bd413f;--d-n4:#e3645f;
 --d-p1:#003578;--d-p2:#0050a4;--d-p3:#1a71cb;--d-p4:#4294f1;}}
:root[data-theme="dark"]{--page:#121211;--surface:#1a1a19;--surface-2:#201f1e;--ink:#fff;
 --ink-2:#c3c2b7;--ink-3:#8d8c84;--line:#2e2e2b;--grid:#272724;--axis:#4e4e4a;--band:#232320;
 --pos:#3987e5;--neg:#e66767;--d-0:#383835;
 --d-n1:#6f000c;--d-n2:#971a20;--d-n3:#bd413f;--d-n4:#e3645f;
 --d-p1:#003578;--d-p2:#0050a4;--d-p3:#1a71cb;--d-p4:#4294f1;}
*{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font:15px/1.62 var(--sans);
 -webkit-font-smoothing:antialiased}
.wrap{max-width:1010px;margin:0 auto;padding:34px 22px 70px}
