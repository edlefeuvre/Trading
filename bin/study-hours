.foot{margin-top:34px;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-3)}
@media print{body{background:#fff}.wrap{padding:0}.card,.figure,.tiles{break-inside:avoid}svg{min-width:0}}
"""
    lg = ('<div class="legend"><span>Mean R</span>'
          + '<span class="swr">' + "".join(f'<span class="sw" style="background:var(--d-n{i})"></span>' for i in (4, 3, 2, 1))
          + f'<span class="sw" style="background:var(--d-0)"></span>'
          + "".join(f'<span class="sw" style="background:var(--d-p{i})"></span>' for i in (1, 2, 3, 4)) + '</span>'
          + '<span>− 0.50 · 0.25 · 0.10 · 0 · 0.10 · 0.25 · 0.50 +</span>'
          + f'<span>hollow = n &lt; {a.min_n}</span></div>')

    html = f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TS01 hours and days study</title><style>{css}</style></head><body><div class="wrap">
<header><div class="kicker">TS01 CHoCH ICT 15m · Binance USDCp · look #9</div>
<h1>Blocks, days, and whether any of it survives</h1>
<p class="sub">{sum(setups.values()):,} setups · {N:,} filled · archive from {a.start} ·
generated {_dt.datetime.now(_dt.timezone.utc):%d %b %Y %H:%M} UTC</p></header>

<div class="card verdict"><p class="big">Unattended R factor {f}</p>
<p style="margin:0">{why}. The sleep split is the only pre-registered comparison here and it is keyed on
<strong>local</strong> time, because it is a question about Ed's clock. Everything below it is keyed on
<strong>UTC</strong>, because those are questions about the market's clock.</p></div>

<div class="tiles">
<div class="tile"><div class="k">Unattended</div><div class="v {'neg' if un['mean']<0 else 'pos'}">{_mns(f"{un['mean']:+.3f}")} R</div>
<div class="n">{un['n']} filled · total {_mns(f"{un['total']:+.1f}")} R · win {100*un['win']:.1f}%</div></div>
<div class="tile"><div class="k">Attended</div><div class="v {'neg' if at['mean']<0 else 'pos'}">{_mns(f"{at['mean']:+.3f}")} R</div>
<div class="n">{at['n']} filled · total {_mns(f"{at['total']:+.1f}")} R · win {100*at['win']:.1f}%</div></div>
<div class="tile"><div class="k">Difference</div><div class="v">{_mns(f"{diff:+.3f}")} R</div>
<div class="n">{abs(diff)/se:.1f} standard errors · {'reliable' if abs(diff)>2*se else 'not reliable'}</div></div>
<div class="tile"><div class="k">Whole strategy</div><div class="v">{_mns(f"{tot/N:+.3f}")} R</div>
<div class="n">{N:,} filled · total {_mns(f"{tot:+.1f}")} R</div></div></div>

<h2>{W}-hour blocks, UTC</h2>
<p>The earlier run keyed the hours on Gibraltar local time, which smears the market clock: 08:00 local is
06:00 UTC in summer and 07:00 UTC — the London open — in winter, so one bucket mixed two sessions. This is
the corrected view, and it is grouped into {W}-hour blocks: {NB} buckets at roughly {N//NB} trades each
rather than 24 at {N//24}. Blocks are not just a convenient width — at three hours they line up with the
sessions, so each bucket means something before the data is looked at.</p>
<p><strong>Two honest costs.</strong> Aggregation buys precision by spending resolution: if a real effect
lives in one hour, a three-hour block dilutes it threefold and can hide it. And the boundary
<em>offset</em> is a free choice — blocks starting at 01:00Z would give different numbers. It is pinned at
00:00Z and is not exposed as a knob, because shifting it until something appears is exactly the search
that manufactures findings.</p>
<figure class="figure">{_bars(ub, -0.5, 1.0, f'{W}-hour block of the FVG bar, UTC · small figure = n', 940, 260)}
<figcaption>{NB} buckets is {NB} looks. Read this for shape, not for a winner.</figcaption></figure>
<details><summary>Hour by hour — the finest resolution, for checking whether a block hides a spike</summary>
<figure class="figure" style="margin-top:10px">{_bars(uh, -0.5, 1.0, 'hour of the FVG bar, UTC · small figure = n')}
<figcaption>If one hour inside a block carries it, the block was the wrong unit.</figcaption></figure></details>

<div class="card warn"><p style="margin:0 0 8px"><strong>The concentration test.</strong> The best UTC hour
is {best[0]}:00Z: n={bn}, mean {_mns(f"{bm:+.3f}")} R, total {_mns(f"{bm*bn:+.1f}")} R —
{100*abs(bm*bn)/abs(tot) if tot else 0:.0f}% of the strategy's whole result from {100*bn/N:.1f}% of its trades.</p>
<p style="margin:0">Without that single hour the remaining {rest_n:,} trades total
{_mns(f"{rest_t:+.1f}")} R, a mean of {_mns(f"{rest_t/rest_n:+.4f}")} R.
Deleting the best of twenty-four buckets is a biased operation and proves nothing on its own — do it to a
genuinely edgeless strategy and you would see the same. What matters is whether the hour sits further from
the pack than chance across 24 looks would put it. Check the standard error against the bucket's n before
believing it, and get the per-trade distribution before acting on it.</p></div>

<details><summary>Table view — UTC hours (all 24)</summary><table><thead><tr><th>Hour UTC</th><th class="n">n</th>
<th class="n">Mean R</th><th class="n">Total R</th></tr></thead><tbody>{rowsfor(uh)}</tbody></table></details>

<h2>Day of week, UTC</h2>
<p>Seven buckets at roughly {N//7} trades each — the least thin cut available, and crypto weekends have a
plausible mechanism behind them in thinner books. Still seven looks, so the same discipline applies: this is
a hypothesis generator, not a result.</p>
<figure class="figure">{_bars(dw, -0.5, 1.0, 'UTC weekday of the FVG bar · small figure = n', 700, 240)}
<figcaption>Mean net R per filled setup by UTC weekday.</figcaption></figure>
<details><summary>Table view — weekdays</summary><table><thead><tr><th>Day</th><th class="n">n</th>
<th class="n">Mean R</th><th class="n">Total R</th></tr></thead><tbody>{rowsfor(dw)}</tbody></table></details>

<h2>Day × block</h2>
<p>{7*NB} cells over {N:,} trades is {N/(7*NB):.1f} per cell. {live} of {7*NB} clear the n={a.min_n} floor; the
rest are drawn hollow with their count only, and should not be read at all. Even at {W}-hour blocks this is a
thin grid, and a thin grid <em>will</em> look patterned whether or not anything is there — that is what noise
looks like when you cut it two ways at once. The honest use of this picture is to ask whether the block shape
above holds steady down the columns. If it does not, the block reading was never structure.</p>
{lg}
<figure class="figure">{_heatmap(grid, DOW, a.min_n, NB, W, True)}
<figcaption>Mean net R by UTC weekday and {W}-hour block. Colour and the printed number carry the same
value, so the cells stay readable without colour.</figcaption></figure>
<details><summary>Table view — the full grid</summary><table class="grid-t"><thead><tr><th></th>
{"".join(f'<th class="n">{bucket_label(b, W)}</th>' for b in range(NB))}</tr></thead><tbody>{grid_rows}</tbody></table></details>

<h2>What this does and does not license</h2>
<ol>
<li><strong>The sleep-window factor stands as the only actionable output</strong>, and only as a
recommendation to the Sunday review. It is not written into <code>params.yaml</code>.</li>
<li><strong>No hour or day filter should be adopted from this page.</strong> Every cut below the
pre-registered split is exploratory and was chosen after seeing the data.</li>
<li><strong>If a cut looks compelling, pre-register it and test it out of sample</strong> — write the
hypothesis and expected direction in §10 first, then split 2024 against 2025–26.</li>
<li><strong>Get the per-trade distribution</strong> for any bucket that carries the result. A mean built
from two outsized winners is not a session effect.</li>
</ol>

<div class="foot"><p style="margin:0 0 4px">Generated by <code>bin/study-hours --html</code>. The
pre-registration — hypothesis, mechanism, expected direction and decision rule — is in
<code>STRATEGY.md</code> §10 and was fixed before the first run.</p>
<p style="margin:0">Every view except the sleep split is post-hoc and labelled as such.</p></div>
</div></body></html>"""
    _P(a.html).write_text(html, encoding="utf-8")



def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--strategy", default="TS01_CHoCH_ICT_15m_Binance_USDCp")
    ap.add_argument("--start", default="2024-01", help="archive start, YYYY-MM")
    ap.add_argument("--all", action="store_true", help="include R-factor-0 symbols too")
    ap.add_argument("--events", default="", help="file of dates (YYYY-MM-DD), one per line, for a secondary bucket")
    ap.add_argument("--html", default="", help="also write a standalone HTML report to this path")
    ap.add_argument("--bucket-hours", type=int, default=3, choices=[1, 2, 3, 4, 6, 8, 12],
                    help="width of the hour-of-day buckets, UTC (default 3). The boundary OFFSET is fixed "
                         "at 00:00Z; shifting it is another look, so it is deliberately not a knob.")
    ap.add_argument("--min-n", type=int, default=15, help="heatmap cells below this n are drawn hollow and never read")
    a = ap.parse_args(argv)

    here = REPO / "strategies" / a.strategy
    params = load_yaml(here / "config" / "params.yaml")
    universe = load_yaml(here / "config" / "universe.yaml")
    entry, structure = params.get("entry", {}), params.get("structure", {})
    k = int(structure.get("pivot_k", engine.K))
    live_bars = int(entry.get("gtc_window_bars", engine.LIVE_BARS))
    sweep_reclaim = int(entry.get("sweep_reclaim_bars", engine.SWEEP_RECLAIM))
    fvg_window = int(entry.get("gap_window_bars", engine.FVG_WINDOW))
    discount_only = bool(entry.get("discount_only", True))
    tf = str(params.get("timeframe", "15m"))

    syms = [str(r["symbol"]).upper() for r in universe.get("symbols", [])
            if isinstance(r, dict) and (a.all or float(r.get("tier", 0) or 0) > 0)]
    y, m = (int(x) for x in a.start.split("-"))

    events = set()
    if a.events:
        for ln in Path(a.events).read_text(encoding="utf-8").splitlines():
            ln = ln.strip()
            if ln and not ln.startswith("#"):
                events.add(ln)

    print(__doc__.split("First run")[0].rstrip())
    print(f"\nsymbols {len(syms)} · archive from {a.start} · sleep window {SLEEP_FROM:02d}:00-{SLEEP_TO:02d}:00 "
          f"local · {TZ_NOTE}\n")

    setups = {"unattended": 0, "attended": 0}
    filled: dict[str, list[dict]] = {"unattended": [], "attended": []}
    ev_setups, ev_filled = {"event": 0, "other": 0}, {"event": [], "other": []}
    by_hour: dict[int, list[dict]] = {h: [] for h in range(24)}      # LOCAL, kept for continuity
    by_uhour: dict[int, list[dict]] = {h: [] for h in range(24)}     # UTC — the market clock
    by_dow: dict[int, list[dict]] = {d: [] for d in range(7)}        # UTC weekday, Mon=0
    NB = 24 // a.bucket_hours
    by_ubucket: dict[int, list[dict]] = {b: [] for b in range(NB)}
    grid: dict[tuple, list[dict]] = {(d, b): [] for d in range(7) for b in range(NB)}

    for sym in syms:
        try:
            bars = data.history(sym, start=(y, m), interval=tf, verbose=False)
        except Exception as ex:  # noqa: BLE001
            print(f"  {sym:<14} ERROR {ex}")
            continue
        if len(bars) < 500:
            print(f"  {sym:<14} only {len(bars)} bars — skipped")
            continue
        evs = engine.live_state(bars, k=k, live_bars=live_bars, report_all=True,
                               sweep_reclaim=sweep_reclaim, fvg_window=fvg_window,
                               discount_only=discount_only)
        closed = [e for e in evs if e["status"] == "closed"]
        for e in evs:
            b = "unattended" if unattended(e["t_placed"]) else "attended"
            setups[b] += 1
            if events:
                d = local_dt(e["t_placed"]).strftime("%Y-%m-%d")
                ev_setups["event" if d in events else "other"] += 1
        for e in closed:
            b = "unattended" if unattended(e["t_placed"]) else "attended"
            filled[b].append(e)
            by_hour[local_dt(e["t_placed"]).hour].append(e)
            u = dt.datetime.fromtimestamp(e["t_placed"] / 1000, dt.timezone.utc)
            by_uhour[u.hour].append(e)
            by_dow[u.weekday()].append(e)
            by_ubucket[u.hour // a.bucket_hours].append(e)
            grid[(u.weekday(), u.hour // a.bucket_hours)].append(e)
            if events:
                d = local_dt(e["t_placed"]).strftime("%Y-%m-%d")
                ev_filled["event" if d in events else "other"].append(e)
        print(f"  {sym:<14} {len(bars):>7} bars · {len(evs):>4} setups · {len(closed):>4} filled")

    un, at = summary(filled["unattended"]), summary(filled["attended"])
    print("\n=== THE PRE-REGISTERED SPLIT ===")
    print(line("unattended", un, setups["unattended"] or 1))
    print(line("attended", at, setups["attended"] or 1))
    if un.get("n") and at.get("n"):
        diff = at["mean"] - un["mean"]
        se = (un["se"] ** 2 + at["se"] ** 2) ** 0.5
        print(f"\n  attended minus unattended: {diff:+.3f} R · se {se:.3f} · "
              f"{'RELIABLE at 2 se' if abs(diff) > 2*se else 'NOT reliable at 2 se'}")
        print(f"  smallest difference this sample could resolve at 2 se: {2*se:.3f} R")
        print("  (the strategy's whole measured edge is +0.02 to +0.11 R — if the resolution above")
        print("   is larger than that, this test can only find a big effect, not a subtle one)")
    f, why = verdict(un, at)
    print(f"\n  PRE-REGISTERED VERDICT — unattended R factor {f}: {why}")
    print(f"  Apply as risk = ceiling x symbol_factor x {f}. Never above 1.0. Charter clause 3 permits")
    print("  sizing down only, so this needs no further argument; raising it later would.")

    if events:
        e1, e2 = summary(ev_filled["event"]), summary(ev_filled["other"])
        print("\n=== SECONDARY: event days (descriptive, underpowered by design) ===")
        print(line("event", e1, ev_setups["event"] or 1))
        print(line("other", e2, ev_setups["other"] or 1))
        if e1.get("n"):
            print(f"  n = {e1['n']}. At sd {e1['sd']:.2f} the 2-se resolution is "
                  f"{2*e1['se']:.3f} R. Treat as description, not evidence.")

    DOW = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    print(f"\n=== DESCRIPTIVE ONLY — {a.bucket_hours}h blocks of the FVG bar, UTC ===")
    print(f"  ({NB} buckets is {NB} looks — fewer than 24, and each is ~{a.bucket_hours}x less thin)")
    for b in range(NB):
        rows = by_ubucket[b]
        note = bucket_note(b, a.bucket_hours)
        if rows:
            t = summary(rows)
            print(f"  {bucket_label(b, a.bucket_hours)}Z  n {t['n']:>4}  mean {t['mean']:+.3f} R  "
                  f"± {t['se']:.3f}  total {t['total']:+7.1f}  win {100*t['win']:>4.1f}%  {note}")
        else:
            print(f"  {bucket_label(b, a.bucket_hours)}Z  n    0  {note}")

    print("\n=== DESCRIPTIVE ONLY — hour of the FVG bar, UTC (finest resolution) ===")
    print("  (24 buckets is 24 looks; do not read a winner out of this table)")
    for h in range(24):
        rows = by_uhour[h]
        if rows:
            t = summary(rows)
            print(f"  {h:02d}:00Z n {t['n']:>4}  mean {t['mean']:+.3f} R  total {t['total']:+7.1f}  win {100*t['win']:>4.1f}%")
        else:
            print(f"  {h:02d}:00Z n    0")

    print("\n=== DESCRIPTIVE ONLY — day of week, UTC ===")
    print("  (7 buckets is 7 looks)")
    for d in range(7):
        rows = by_dow[d]
        if rows:
            t = summary(rows)
            print(f"  {DOW[d]}  n {t['n']:>4}  mean {t['mean']:+.3f} R  total {t['total']:+7.1f}  win {100*t['win']:>4.1f}%")
        else:
            print(f"  {DOW[d]}  n    0")

    print(f"\n=== DESCRIPTIVE ONLY — day x {a.bucket_hours}h block, UTC · mean R · "
          f"cells with n < {a.min_n} shown as . ===")
    print("      " + "".join(f"{bucket_label(b, a.bucket_hours):>9}" for b in range(NB)))
    for d in range(7):
        cells = []
        for b in range(NB):
            rows = grid[(d, b)]
            cells.append(f"{summary(rows)['mean']:>+9.2f}" if len(rows) >= a.min_n else f"{'.':>9}")
        print(f"  {DOW[d]} " + "".join(cells))
    ncell = [len(grid[k]) for k in grid]
    NC = 7 * NB
    print(f"  {NC} cells, {sum(ncell)} trades, mean {sum(ncell)/NC:.1f} per cell, "
          f"{sum(1 for x in ncell if x >= a.min_n)} at or above n={a.min_n}")
    print("  A grid this thin will look patterned whether or not anything is there. It is here to")
    print("  show whether structure survives being cut two ways at once — usually it does not.")

    print("\n=== DESCRIPTIVE ONLY — hour of the FVG bar, local (superseded by the UTC table above) ===")
    print("  (24 buckets is 24 looks; do not read a winner out of this table)")
    for h in range(24):
        rows = by_hour[h]
        mark = " *" if (h >= SLEEP_FROM or h < SLEEP_TO) else "  "
        if rows:
            s = summary(rows)
            print(f"  {h:02d}:00{mark} n {s['n']:>4}  mean {s['mean']:+.3f} R  total {s['total']:+7.1f}  win {100*s['win']:>4.1f}%")
        else:
            print(f"  {h:02d}:00{mark} n    0")
    print("  * = inside the sleep window")

    if a.html:
        write_html(a, un, at, setups, filled, by_uhour, by_ubucket, by_dow, grid, DOW, NB)
        print(f"\nreport written to {a.html}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
