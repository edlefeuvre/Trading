#!/usr/bin/env bash
# pre-commit: code and STRATEGY.md change together.
#
# Rule: if a commit touches strategies/<TS>/{pine,src,config}/ then that
# strategy's STRATEGY.md must also be staged AND its "## Change log" table must
# gain at least one row. If a commit touches common/engine or common/exchange,
# every strategy's STRATEGY.md must gain a row (shared behaviour changed).
#
# Enable with: make hooks   (git config core.hooksPath .githooks)
# Bypass is deliberately not documented.

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

fail=0
red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }

# Count change-log rows in a STRATEGY.md at a given ref ("" = index)
changelog_rows() {
  local path=$1 ref=$2 content
  if [ "$ref" = "index" ]; then
    content=$(git show ":$path" 2>/dev/null || true)
  else
    content=$(git show "HEAD:$path" 2>/dev/null || true)
  fi
  # rows after the "## Change log" heading that start with "| 20" (a date)
  printf '%s\n' "$content" | awk '/^## Change log/{f=1;next} f && /^\| *20[0-9][0-9]-/{n++} END{print n+0}'
}

check_strategy() {
  local ts=$1 reason=$2
  local doc="strategies/$ts/STRATEGY.md"
  if ! printf '%s\n' "$staged" | grep -qx "$doc"; then
    red "✗ $ts: $reason but $doc is not staged"
    fail=1; return
  fi
  local before after
  before=$(changelog_rows "$doc" head)
  after=$(changelog_rows "$doc" index)
  if [ "$after" -le "$before" ]; then
    red "✗ $ts: $doc staged but no new row in '## Change log' ($before → $after)"
    fail=1; return
  fi
  # version must have changed if the doc changed
  local vb va
  vb=$(git show "HEAD:$doc" 2>/dev/null | awk -F': *' '/^version:/{print $2; exit}' || true)
  va=$(git show ":$doc" | awk -F': *' '/^version:/{print $2; exit}')
  if [ -n "$vb" ] && [ "$vb" = "$va" ]; then
    red "✗ $ts: change-log row added but frontmatter version unchanged ($va)"
    fail=1; return
  fi
  green "✓ $ts: change log +$((after-before)) row(s), version $vb → $va"
}

# 1. strategy-local code changes
touched_ts=$(printf '%s\n' "$staged" \
  | grep -E '^strategies/(TS[0-9]{2}_[A-Za-z0-9_]+_[A-Za-z0-9]+_[A-Za-z0-9]+)/(pine|src|config|systemd)/' \
  | sed -E 's#^strategies/([^/]+)/.*#\1#' | sort -u || true)
for ts in $touched_ts; do
  check_strategy "$ts" "code/config changed"
done

# 2. shared engine/exchange changes → every strategy
if printf '%s\n' "$staged" | grep -qE '^common/(engine|exchange)/'; then
  for d in strategies/TS*/; do
    ts=$(basename "$d")
    check_strategy "$ts" "common/engine or common/exchange changed"
  done
fi

# 3. never commit secrets or logs
if printf '%s\n' "$staged" | grep -vE '(\.gitkeep$|^deploy/)' | grep -qE '(\.env$|/logs/|data/cache/)'; then
  red "✗ refusing to commit .env, logs/ or data cache files"
  fail=1
fi

# 4. run the consistency checker if present
if [ -x bin/check-strategy ] && [ -n "$touched_ts" ]; then
  for ts in $touched_ts; do
    bin/check-strategy "$ts" || fail=1
  done
fi

if [ "$fail" -ne 0 ]; then
  red "commit blocked — see CLAUDE.md 'Before editing anything'"
  exit 1
fi
exit 0
